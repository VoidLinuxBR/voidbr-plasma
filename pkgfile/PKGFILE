pkgname=voidbr-plasma
pkgdesc="VoidBR PLASMA Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=()  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=() # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	voidbr-base-common
	voidbr-xorg-common
	voidbr-wayland-common
	voidbr-gui-common
	kde5                     # Meta-pacote do ambiente KDE Plasma 5
	plasma-desktop
	plasma-nm
	plasma-pa
	plasma-disks
	kf6-kaccounts-integration
	kaccounts-providers
	signon-kwallet-extension
	ark
	kwalletmanager
	spectacle
	powerdevil                # Power consumption settings of a Plasma
	dolphin                   # Gerenciador de arquivos do KDE
	kate                      # Editor de texto avançado do KDE
	konsole                   # Terminal padrão do KDE
	# voidbr-dracula-theme
	# voidbr-professional-theme
  voidbr-tokyo-theme
	voidbr-plasma-config
)
backup=()

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
	install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
	install=pkgfile.install
fi

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
  log "Aplicando configuracoes para $user"
  # cd $user_home
  # cp -Rpa /etc/skel/. .
  # chown $user:$user . -R
  /usr/local/bin/voidbr-copy-skel-inc --user $user --force --quiet || true

  log "Ativando serviços"
  /usr/local/bin/vservice add sddm --quiet || true

  log "Finalizando instalação"
}

post_install() {
  if [ -n "$user" ] ; then
    log "Aplicando configuracoes para $user"
    /usr/local/bin/voidbr-copy-skel-inc --user "$user" --force --quiet || true
  fi

  log "Ativando serviços"
  /usr/local/bin/vservice add sddm --quiet || true

  log "Finalizando instalação"
  log "${YELLOW}Instalação completa. Reinicie o sistema...${RESET}"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
